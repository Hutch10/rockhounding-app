# Rockhound V1 — Environment Matrix (DEPLOY-001)
# Copy to apps/web/.env.local for local development.
# See docs/implementation/README.md

# ─── Supabase (required) ───────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (migrations / scripts) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Maps (required for MapClient) ─────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# ─── Auth redirects (AUTH-001) ─────────────────────────────────────────────
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL:        http://localhost:3000
#   Redirect URLs:   http://localhost:3000/**
#                      https://your-preview.vercel.app/**
#                      https://your-production-domain.com/**
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Observability (V1) ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
VERCEL_OIDC_TOKEN=
