{
  "name": "rockhounding-app",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade Rockhounding + Geologist web application for HutchSolves",
  "scripts": {
    "dev": "pnpm run --parallel /dev:(web|shared)/",
    "build": "pnpm run -r build",
    "test": "pnpm run -r test",
    "test:core": "pnpm build:core && pnpm --filter @rockhounding/shared build && vitest run packages/hutchstack-core",
    "build:core": "pnpm -r --filter \"@hutchstack/core-*\" build",
    "type-check:core": "pnpm build:core && pnpm --filter \"@hutchstack/core-*\" type-check",
    "test:ci": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx && pnpm --filter web run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "type-check": "pnpm run -r type-check",
    "integrity-check": "tsx scripts/sync-enums.ts",
    "audit:rls": "tsx scripts/audit-rls.ts",
    "prepare": "husky install"
  },
  "engines": {
    "node": "20.x",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "fake-indexeddb": "^6.2.5",
    "@playwright/test": "^1.49.1",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  }
}
